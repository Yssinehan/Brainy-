# Copy to .env and fill in real values. Never commit .env.

# Chat, RAG generation, and agent actions use Ollama exclusively.
# Install it from https://ollama.com, then run: ollama pull llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# CPU-friendly settings. Increase these only when longer answers are required.
OLLAMA_MAX_TOKENS=64
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
# OLLAMA_NUM_THREAD=8
RETRIEVAL_TOP_K=2
RAG_CONTEXT_MAX_CHARS=1200

# Local embedding model (no API key).
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Single absolute root for db/chroma/workspace/voice data. If unset, defaults
# to this repository's ./data directory.
# NEXUS_DATA_DIR=C:\Users\Elitebook\Desktop\Brainy Model\data
